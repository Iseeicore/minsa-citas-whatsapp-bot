generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "chatbot"]
}

enum ConversationStatus {
  OPEN
  CLOSED

  @@schema("public")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@schema("public")
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  LOCATION
  TEMPLATE
  UNKNOWN

  @@schema("public")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@schema("public")
}

model Conversation {
  id            String             @id @default(cuid())
  waId          String             @unique
  phoneNumber   String?
  profileName   String?
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  messages      Message[]

  @@index([lastMessageAt])
  @@schema("public")
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  direction      MessageDirection
  type           MessageType
  content        String?
  mediaUrl       String?
  waMessageId    String?          @unique
  status         MessageStatus    @default(PENDING)
  timestamp      DateTime
  createdAt      DateTime         @default(now())

  @@index([conversationId, timestamp])
  @@schema("public")
}

model SandboxSession {
  id        String   @id
  state     String
  slots     Json
  counters  Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@schema("public")
}

model SesionConversacion {
  id                String   @id(map: "pk_sesion_conversacion") @default(dbgenerated("uuidv7()")) @db.Uuid
  waId              String   @unique(map: "uq_sesion_conversacion_wa_id") @map("wa_id")
  estado            String
  slots             Json
  contadores        Json
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  fechaModificacion DateTime @default(now()) @map("fecha_modificacion") @db.Timestamptz(3)

  @@index([fechaModificacion], map: "ix_sesion_conversacion_fecha_modificacion")
  @@map("sesion_conversacion")
  @@schema("chatbot")
}
