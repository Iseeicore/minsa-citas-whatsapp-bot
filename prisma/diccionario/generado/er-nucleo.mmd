erDiagram
    evidencia |o--o{ archivo_recibido : "evidencia_id"
    solicitud_carga ||--o{ archivo_recibido : "solicitud_carga_id"
    incidencia_paciente ||--o{ evidencia : "incidencia_paciente_id"
    mensaje |o--o{ evidencia : "mensaje_id"
    mensaje |o--o{ incidencia_paciente : "mensaje_id"
    usuario ||--o{ incidencia_paciente : "usuario_id"
    incidencia_paciente ||--o{ incidencia_paciente_auditoria : "incidencia_paciente_id"
    usuario ||--o{ mensaje : "usuario_id"
    incidencia_paciente ||--o{ solicitud_carga : "incidencia_paciente_id"
    usuario ||--o{ solicitud_carga : "usuario_id"
    rol ||--o{ rol_categoria : "rol_id"
    usuario_interno ||--o{ sesion_usuario : "usuario_interno_id"
    rol ||--o{ usuario_rol : "rol_id"
    usuario_interno ||--o{ usuario_rol : "usuario_interno_id"
    incidencia_paciente ||--o{ entrenamiento_categoria : "incidencia_paciente_id"

    archivo_recibido {
        uuid id PK
        uuid solicitud_carga_id FK
        text nombre_original
        text mime_declarado
        text mime_detectado
        bigint tamano
        text hash_archivo
        text ruta_cuarentena
        smallint estado_archivo_id FK "catalogo estado_archivo"
        text motivo_rechazo
        timestamptz verificado_en
        uuid evidencia_id FK
        bloque auditoria
    }
    evidencia {
        uuid id PK
        uuid incidencia_paciente_id FK
        uuid mensaje_id FK
        text media_id
        smallint tipo_evidencia_id FK "catalogo tipo_evidencia"
        text mime_type
        text nombre_archivo
        int tamano
        text ruta
        text hash_archivo
        timestamptz fecha_recepcion
        bloque auditoria
    }
    incidencia_paciente {
        uuid id PK
        smallint canal_origen_id FK "catalogo canal_origen"
        uuid usuario_id FK
        uuid mensaje_id FK
        text wa_id
        boolean es_anonimo
        text dni_reclamante
        text nombre_reclamante
        text descripcion
        smallint estado_incidencia_id FK "catalogo estado_incidencia"
        text trace_id
        smallint categoria_id FK "catalogo categoria_incidencia"
        smallint categoria_ia_id FK "catalogo categoria_incidencia"
        numeric categoria_confianza
        text version_clasificador
        timestamptz categoria_asignada_en
        timestamptz categoria_corregida_en
        text categoria_corregida_por
        timestamptz categoria_confirmada_en
        text categoria_confirmada_por
        text resolucion
        timestamptz resuelto_en
        text resuelto_por
        boolean activo
        timestamptz eliminado_en
        text eliminado_por
        bloque auditoria
    }
    incidencia_paciente_auditoria {
        bigint id PK
        uuid incidencia_paciente_id FK
        varchar operacion
        jsonb cambios
        text actor
        timestamptz fecha_hora
        bloque auditoria
    }
    mensaje {
        uuid id PK
        uuid usuario_id FK
        smallint direccion_mensaje_id FK "catalogo direccion_mensaje"
        smallint tipo_mensaje_id FK "catalogo tipo_mensaje"
        text contenido
        text media_id
        text wa_message_id
        smallint estado_mensaje_id FK "catalogo estado_mensaje"
        timestamptz fecha_hora
        bloque auditoria
    }
    sesion_conversacion {
        uuid id PK
        text wa_id
        text estado
        jsonb slots
        jsonb contadores
        bloque auditoria
    }
    solicitud_carga {
        uuid id PK
        uuid incidencia_paciente_id FK
        uuid usuario_id FK
        text hash_token
        timestamptz vence_en
        timestamptz cerrada_en
        smallint max_archivos
        int max_bytes_archivo
        bloque auditoria
    }
    usuario {
        uuid id PK
        text wa_id
        text profile_name
        text phone_number
        text dni
        text nombre_completo
        smallint estado_conversacion_id FK "catalogo estado_conversacion"
        timestamptz ultimo_mensaje_en
        boolean activo
        timestamptz eliminado_en
        text eliminado_por
        bloque auditoria
    }
    rol {
        smallint id PK
        text codigo
        text nombre
        text descripcion
        boolean activo
        bloque auditoria
    }
    rol_categoria {
        smallint rol_id PK, FK
        smallint categoria_incidencia_id PK, FK "catalogo categoria_incidencia"
        bloque auditoria
    }
    sesion_usuario {
        uuid id PK
        uuid usuario_interno_id FK
        timestamptz ultima_actividad_en
        timestamptz vence_en
        timestamptz revocada_en
        bloque auditoria
    }
    usuario_interno {
        uuid id PK
        text nombre_completo
        text correo
        boolean activo
        timestamptz eliminado_en
        text eliminado_por
        text password_hash
        bloque auditoria
    }
    usuario_rol {
        uuid usuario_interno_id PK, FK
        smallint rol_id PK, FK
        bloque auditoria
    }
    entrenamiento_categoria {
        uuid id PK
        uuid incidencia_paciente_id FK
        text texto_entrenamiento
        smallint categoria_ia_id FK "catalogo categoria_incidencia"
        smallint categoria_final_id FK "catalogo categoria_incidencia"
        boolean fue_corregida
        numeric categoria_confianza
        text version_clasificador
        text revisado_por
        timestamptz fecha_revision
        bloque auditoria
    }
