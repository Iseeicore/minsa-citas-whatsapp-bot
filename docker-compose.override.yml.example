services:
  minsa-citas-whatsapp-bot:
    build:
      target: deps
    image: minsa-citas-whatsapp-bot:dev
    command: ["npm", "run", "dev"]
    environment:
      NODE_ENV: development
    ports:
      - "${HOST_PORT:-3000}:3000"
    volumes:
      - .:/app
      - /app/node_modules
      - /app/.next
    healthcheck:
      disable: true
    deploy:
      resources:
        limits:
          memory: ${MEM_LIMIT:-1g}
