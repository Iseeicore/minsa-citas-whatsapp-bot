{
  "name": "minsa-citas-whatsapp-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && node scripts/db-aplicar-sql.mjs && next build --webpack",
    "build:no-db": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:gaps": "vitest run --mode strict-gaps",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "smoke:postgres": "vitest run --config vitest.smoke.config.ts",
    "db:test": "node scripts/db-test.mjs",
    "db:aplicar": "node scripts/db-aplicar-sql.mjs",
    "db:seed:eess": "node scripts/db-seed-eess.mjs",
    "db:seed:dev": "node scripts/db-seed-dev.mjs",
    "db:diccionario": "node docs/base-de-datos/generar-diccionario.mjs",
    "postinstall": "prisma generate",
    "docker:up": "docker compose up -d --build --wait --wait-timeout 180",
    "docker:logs": "docker compose logs -f",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "next": "16.4.3",
    "prisma": "^6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
